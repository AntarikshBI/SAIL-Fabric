{
  "name": "SAIL_Dashboard_Model",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "agg_plant_daily_summary",
        "lineageTag": "11111111-1111-1111-1111-111111110001",
        "columns": [
          {"name": "plant_id", "dataType": "string", "sourceColumn": "plant_id", "lineageTag": "11111111-1111-1111-1111-111111110010"},
          {"name": "plant_name", "dataType": "string", "sourceColumn": "plant_name", "lineageTag": "11111111-1111-1111-1111-111111110011"},
          {"name": "source_date", "dataType": "dateTime", "sourceColumn": "source_date", "lineageTag": "11111111-1111-1111-1111-111111110012"},
          {"name": "total_hot_metal", "dataType": "double", "sourceColumn": "total_hot_metal", "lineageTag": "11111111-1111-1111-1111-111111110013"},
          {"name": "target_hot_metal", "dataType": "double", "sourceColumn": "target_hot_metal", "lineageTag": "11111111-1111-1111-1111-111111110014"},
          {"name": "total_crude_steel", "dataType": "double", "sourceColumn": "total_crude_steel", "lineageTag": "11111111-1111-1111-1111-111111110015"},
          {"name": "target_crude_steel", "dataType": "double", "sourceColumn": "target_crude_steel", "lineageTag": "11111111-1111-1111-1111-111111110016"},
          {"name": "total_saleable_steel", "dataType": "double", "sourceColumn": "total_saleable_steel", "lineageTag": "11111111-1111-1111-1111-111111110017"},
          {"name": "target_saleable_steel", "dataType": "double", "sourceColumn": "target_saleable_steel", "lineageTag": "11111111-1111-1111-1111-111111110018"},
          {"name": "overall_achievement_pct", "dataType": "double", "sourceColumn": "overall_achievement_pct", "lineageTag": "11111111-1111-1111-1111-111111110019"}
        ],
        "partitions": [
          {
            "name": "agg_plant_daily_summary-partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(SQLEndpoint, \"Gold__lh\"),",
                "    dbo_agg_plant_daily_summary = Source{[Schema=\"dbo\",Item=\"agg_plant_daily_summary\"]}[Data]",
                "in",
                "    dbo_agg_plant_daily_summary"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Hot Metal",
            "expression": "SUM(agg_plant_daily_summary[total_hot_metal])",
            "formatString": "#,##0",
            "lineageTag": "22222222-2222-2222-2222-222222220001"
          },
          {
            "name": "Target Hot Metal",
            "expression": "SUM(agg_plant_daily_summary[target_hot_metal])",
            "formatString": "#,##0",
            "lineageTag": "22222222-2222-2222-2222-222222220002"
          },
          {
            "name": "Total Crude Steel",
            "expression": "SUM(agg_plant_daily_summary[total_crude_steel])",
            "formatString": "#,##0",
            "lineageTag": "22222222-2222-2222-2222-222222220003"
          },
          {
            "name": "Target Crude Steel",
            "expression": "SUM(agg_plant_daily_summary[target_crude_steel])",
            "formatString": "#,##0",
            "lineageTag": "22222222-2222-2222-2222-222222220004"
          },
          {
            "name": "Total Saleable Steel",
            "expression": "SUM(agg_plant_daily_summary[total_saleable_steel])",
            "formatString": "#,##0",
            "lineageTag": "22222222-2222-2222-2222-222222220005"
          },
          {
            "name": "Target Saleable Steel",
            "expression": "SUM(agg_plant_daily_summary[target_saleable_steel])",
            "formatString": "#,##0",
            "lineageTag": "22222222-2222-2222-2222-222222220006"
          },
          {
            "name": "Achievement %",
            "expression": "AVERAGE(agg_plant_daily_summary[overall_achievement_pct])",
            "formatString": "0.0\"%\"",
            "lineageTag": "22222222-2222-2222-2222-222222220007"
          },
          {
            "name": "Hot Metal Achievement %",
            "expression": "DIVIDE([Total Hot Metal], [Target Hot Metal], 0) * 100",
            "formatString": "0.0\"%\"",
            "lineageTag": "22222222-2222-2222-2222-222222220008"
          },
          {
            "name": "Crude Steel Achievement %",
            "expression": "DIVIDE([Total Crude Steel], [Target Crude Steel], 0) * 100",
            "formatString": "0.0\"%\"",
            "lineageTag": "22222222-2222-2222-2222-222222220009"
          },
          {
            "name": "Saleable Steel Achievement %",
            "expression": "DIVIDE([Total Saleable Steel], [Target Saleable Steel], 0) * 100",
            "formatString": "0.0\"%\"",
            "lineageTag": "22222222-2222-2222-2222-222222220010"
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "SQLEndpoint",
        "kind": "m",
        "expression": [
          "\"REPLACE_WITH_SQL_ENDPOINT.datawarehouse.fabric.microsoft.com\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
        ]
      }
    ],
    "annotations": [
      {"name": "PBI_QueryOrder", "value": "[\"SQLEndpoint\",\"agg_plant_daily_summary\"]"},
      {"name": "__PBI_TimeIntelligenceEnabled", "value": "0"},
      {"name": "PBIDesktopVersion", "value": "2.130.0"}
    ]
  }
}
