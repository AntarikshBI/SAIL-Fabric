{
  "name": "SAIL_CEO_Dashboard",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "agg_plant_daily_summary",
        "columns": [
          {"name": "plant_id", "dataType": "string", "sourceColumn": "plant_id"},
          {"name": "plant_name", "dataType": "string", "sourceColumn": "plant_name"},
          {"name": "source_date", "dataType": "dateTime", "sourceColumn": "source_date"},
          {"name": "total_hot_metal", "dataType": "double", "sourceColumn": "total_hot_metal"},
          {"name": "target_hot_metal", "dataType": "double", "sourceColumn": "target_hot_metal"},
          {"name": "total_crude_steel", "dataType": "double", "sourceColumn": "total_crude_steel"},
          {"name": "target_crude_steel", "dataType": "double", "sourceColumn": "target_crude_steel"},
          {"name": "total_saleable_steel", "dataType": "double", "sourceColumn": "total_saleable_steel"},
          {"name": "target_saleable_steel", "dataType": "double", "sourceColumn": "target_saleable_steel"},
          {"name": "avg_hot_metal_achievement", "dataType": "double", "sourceColumn": "avg_hot_metal_achievement"},
          {"name": "avg_crude_steel_achievement", "dataType": "double", "sourceColumn": "avg_crude_steel_achievement"},
          {"name": "avg_saleable_steel_achievement", "dataType": "double", "sourceColumn": "avg_saleable_steel_achievement"},
          {"name": "overall_achievement_pct", "dataType": "double", "sourceColumn": "overall_achievement_pct"}
        ],
        "partitions": [
          {
            "name": "agg_plant_daily_summary",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "agg_plant_daily_summary",
              "expressionSource": "DatabaseQuery"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Hot Metal",
            "expression": "SUM(agg_plant_daily_summary[total_hot_metal])",
            "formatString": "#,##0"
          },
          {
            "name": "Target Hot Metal",
            "expression": "SUM(agg_plant_daily_summary[target_hot_metal])",
            "formatString": "#,##0"
          },
          {
            "name": "Total Crude Steel",
            "expression": "SUM(agg_plant_daily_summary[total_crude_steel])",
            "formatString": "#,##0"
          },
          {
            "name": "Target Crude Steel",
            "expression": "SUM(agg_plant_daily_summary[target_crude_steel])",
            "formatString": "#,##0"
          },
          {
            "name": "Total Saleable Steel",
            "expression": "SUM(agg_plant_daily_summary[total_saleable_steel])",
            "formatString": "#,##0"
          },
          {
            "name": "Target Saleable Steel",
            "expression": "SUM(agg_plant_daily_summary[target_saleable_steel])",
            "formatString": "#,##0"
          },
          {
            "name": "Achievement %",
            "expression": "AVERAGE(agg_plant_daily_summary[overall_achievement_pct])",
            "formatString": "0.0'%'"
          },
          {
            "name": "Hot Metal Achievement %",
            "expression": "DIVIDE([Total Hot Metal], [Target Hot Metal], 0) * 100",
            "formatString": "0.0'%'"
          },
          {
            "name": "Crude Steel Achievement %",
            "expression": "DIVIDE([Total Crude Steel], [Target Crude Steel], 0) * 100",
            "formatString": "0.0'%'"
          },
          {
            "name": "Saleable Steel Achievement %",
            "expression": "DIVIDE([Total Saleable Steel], [Target Saleable Steel], 0) * 100",
            "formatString": "0.0'%'"
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DatabaseQuery",
        "kind": "m",
        "expression": "let\n    database = Sql.Database(\"<LAKEHOUSE_SQL_ENDPOINT>\", \"Gold__lh\")\nin\n    database"
      }
    ]
  }
}
